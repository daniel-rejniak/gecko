#!/bin/sh
# Temporary Docker "get" helper for GAR on GCE workers. Requires curl and jq.
# Keep the allowlist root-owned. Tokens are returned to the caller, never saved.
set +x
set -eu

if [ "$#" -ne 1 ] || [ "$1" != get ]; then
    echo 'gcp: only credential lookup is supported' >&2
    exit 1
fi
registry=''
IFS= read -r registry || [ -n "$registry" ] || exit 1
registry=${registry#https://}
hosts_file=/etc/containers/gcp-gar-credential-helper-hosts
if [ ! -r "$hosts_file" ]; then
    echo 'gcp: registry allowlist is unavailable' >&2
    exit 1
fi
permitted=false
while IFS= read -r allowed || [ -n "$allowed" ]; do
    if [ -n "$allowed" ] && [ "$registry" = "$allowed" ]; then
        permitted=true
        break
    fi
done < "$hosts_file"
if [ "$permitted" != true ]; then
    echo 'gcp: registry is not allowed' >&2
    exit 1
fi

if ! response=$(/usr/bin/curl --fail --silent --show-error \
    --noproxy 169.254.169.254 --connect-timeout 2 --max-time 5 \
    --retry 2 --retry-delay 1 --retry-max-time 15 \
    -H 'Metadata-Flavor: Google' \
    http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token \
    2>/dev/null); then
    echo 'gcp: metadata credential request failed' >&2
    exit 1
fi
# Capture before printing: invalid/multiple responses must not emit credentials.
if ! credential=$(printf '%s' "$response" | /usr/bin/jq -cse '
    if length == 1 and (.[0] | type == "object") then .[0]
    else error("invalid response") end
    | if (.access_token | type == "string" and length > 0)
         and (.expires_in | type == "number" and . > 0)
         and (.token_type | type == "string" and ascii_downcase == "bearer")
      then {Username:"oauth2accesstoken",Secret:.access_token}
      else error("invalid credential") end' 2>/dev/null); then
    echo 'gcp: metadata returned an invalid credential' >&2
    exit 1
fi
printf '%s\n' "$credential"
